<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration (une seule fois)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Adresse Gmail d'envoi (compte qui enverra le mail)"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputFromEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:hint="exemple@gmail.com" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2) Mot de passe d'application Gmail (16 caractères)"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputAppPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="xxxx xxxx xxxx xxxx" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3) Destinataire du trajet"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputToEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:text="cashredac@gmail.com" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textStyle="italic"
            android:text="" />

        <Button
            android:id="@+id/btnGrantPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Étape A — Autoriser la localisation" />

        <Button
            android:id="@+id/btnBackgroundPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Étape B — Localisation en arrière-plan (Toujours)" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Étape C — Désactiver l'optimisation batterie" />

        <Button
            android:id="@+id/btnExactAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Étape D — Autoriser les alarmes exactes" />

        <Button
            android:id="@+id/btnSaveStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Étape E — Enregistrer et démarrer" />

        <Button
            android:id="@+id/btnTestEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Envoyer un mail de test maintenant" />

        <Button
            android:id="@+id/btnHideIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Étape F — Masquer l'icône (terminer)" />

    </LinearLayout>
</ScrollView>
